# Copy to .env (repository root) only if you need to change the defaults. Contains no secrets.

# Folder containing orders.csv, returns.csv, products.csv, customers.csv (default: ./data)
SHOPSPHERE_DATA_DIR=
# Comma-separated origins allowed to call the API from a browser
SHOPSPHERE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEBUG, INFO, WARNING, ERROR
SHOPSPHERE_LOG_LEVEL=INFO

# The frontend reads its API URL from frontend/.env (see frontend/.env.example):
# VITE_API_BASE_URL=http://127.0.0.1:8000
